class Environment:
    def __init__(self):
        # Inpute dirty or clean 
        print("Set initial state for the rooms (enter 'dirty' or 'clean'):")
        state_a = input("Is room A Clean or Dirty?: ").strip().lower()
        state_b = input("Is room B Clean or Dirty?: ").strip().lower()
        
        self.rooms = {
            'A': state_a if state_a in ['dirty', 'clean'] else 'dirty',
            'B': state_b if state_b in ['dirty', 'clean'] else 'dirty'
        }

    def is_dirty(self, room):
        return self.rooms[room] == 'dirty'

    def clean_room(self, room):
        self.rooms[room] = 'clean'

    def get_state(self):
        return self.rooms.copy()


class VacuumAgent:
    def __init__(self, start_room='A'):
        self.location = start_room  # Agent starting location

    def perceive_and_act(self, env):
        #If the current room is DIRTY, clean it
        if env.is_dirty(self.location):
            env.clean_room(self.location)
            return f"Cleaned room {self.location}"
        
        #If the current room is CLEAN, move to the other room
        else:
            self.move()
            return f"Moved to room {self.location}"

    def move(self):
        # Switch to room A and room B
        if self.location == 'A':
            self.location = 'B'
        else:
            self.location = 'A'




def run_simulation():
    env = Environment()
    
    # Ask user where the agent starts and how many steps to run
    start_loc = input("Enter starting room for agent ('A' or 'B'): ").strip().upper()
    if start_loc not in ['A', 'B']:
        start_loc = 'A'
        
    steps = int(input("Enter number of steps to run: "))
    
    agent = VacuumAgent(start_loc)
    
    for step in range(1, steps + 1):
        action = agent.perceive_and_act(env)
        current_state = env.get_state()
        
        print(f"Step {step}:")
        print(f"  Agent Location: Room {agent.location}")
        print(f"  Action Taken: {action}")
        print(f"  Environment State: {current_state}\n")

if __name__ == "__main__":
    run_simulation()
